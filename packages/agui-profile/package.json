{
  "name": "@2060.io/ayni-agui-profile",
  "version": "3.0.0",
  "description": "Ayni AG-UI Profile v3: the wire contract between a Ayni Agent and a Ayni UI (types, constants, JSON schemas)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/2060-io/ayni-agent",
    "directory": "packages/agui-profile"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
