{
  "name": "@ayni.org/ayni-ui-core",
  "version": "0.3.0",
  "description": "Framework-independent core of the Ayni UI (UI-SHELL-004): agents and controllers, trust resolution, sessions and binding, the conversation reducer, the local store and sync; shared by the browser UI and the Ayni app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ayni.org/ayni-agui-profile": "^3.1.0",
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/2060-io/ayni-ui/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/2060-io/ayni-ui",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ayni",
    "ag-ui",
    "verifiable-trust"
  ]
}
