{
  "name": "ayni-ui",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Ayni UI: the browser Verifiable User Agent for Ayni Agents (ayni-spec v3)",
  "scripts": {
    "dev": "vite",
    "build": "pnpm -r --filter './packages/**' build && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "check-format": "biome check --unsafe",
    "fix-format": "biome check --write --unsafe",
    "check-types": "pnpm -r --filter './packages/**' build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "pnpm check-types && pnpm check-format"
  },
  "dependencies": {
    "@ayni.org/ayni-agui-profile": "^3.1.0",
    "@ayni.org/ayni-ui-core": "workspace:*",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "i18next": "^26.4.4",
    "idb": "^8.0.4",
    "lucide-react": "^1.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only"
}
