# Container variables (rendered into config.json at start by docker/entrypoint.sh). No secrets.
PORT=8080
PUBLIC_URL=https://ui.example.com
DEFAULT_AGENT=
SINGLE_AGENT=false
TRUST_POLICY=refuse
TRUST_RECHECK_INTERVAL_SECONDS=900
VERANA_INDEXER_URL=https://idx.devnet.verana.network
VERANA_GRAPH_URL=https://graph.devnet.verana.network
DID_RESOLVER_URL=
ALLOWED_AGENT_ORIGINS=
BRAND_CONFIG_URL=
LOCALES=en,es,fr,pt
DEFAULT_LOCALE=
SOUNDS_ENABLED=true
INSTALL_PROMPT_ENABLED=true
